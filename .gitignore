# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm is the package manager (see package.json "packageManager"); the Docker
# build copies only pnpm-lock.yaml. A package-lock.json from a stray
# `npm install` would desync from it silently.
package-lock.json
yarn.lock

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# worker bundle + generated exports
/dist
/.exports

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase cli scratch
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts
