# ==============================================================================
# TARANG 2026 — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local (for local development) or .env (on production host).
#
# Rules:
# 1. NEVER commit real secrets, private keys, service role keys, or database URLs.
# 2. Local development boots with minimal Supabase credentials; individual features
#    fail gracefully when optional service credentials are unset.
# 3. In production (APP_ENV=production), strict validation is enforced on startup.
# ==============================================================================

# --- [1] Core Application -----------------------------------------------------
# (Optional) Node environment: development | test | production
NODE_ENV=development

# (Optional) Application stage: local | test | staging | production (default: local)
APP_ENV=local

# (Required in Prod, Optional in Dev) Canonical base URL of the app
APP_BASE_URL=https://tarang.example.com

# (Optional) Subdomain overrides for multi-host setup
PUBLIC_SITE_URL=https://tarang.example.com
REGISTRATION_SITE_URL=https://register.tarang.example.com
ADMIN_SITE_URL=https://admin.tarang.example.com
SCANNER_SITE_URL=https://scan.tarang.example.com
HOOKS_BASE_URL=https://hooks.tarang.example.com

# (Optional) App timezone (default: Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata

# (Optional) Release digest / git commit SHA (set by CI/CD for cache partitioning)
# DEPLOYMENT_ID=

# (Optional in Dev, Recommended in Prod) 32-byte secret for Next.js Server Actions encryption
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# (Optional) Log level: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# --- [2] Supabase (Database, Auth & Realtime) ---------------------------------
# NOTE: NEXT_PUBLIC_* are inlined into the client bundle at BUILD time — they must be
# passed to `docker build` as --build-arg when building Docker images (see Dockerfile).
# (Required) Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# (Required) Supabase anon / publishable key (safe for browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# (Required for Server/Worker) Supabase service role secret key (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# (Optional) Session pooler URL (port 5432) for background workers
# SUPABASE_DB_SESSION_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# (Optional) Direct postgres connection URL (port 6543 / 5432) for migrations & scripts
# SUPABASE_DB_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres?pgbouncer=true


# --- [3] Upstash Redis (Caching & Rate Limiting) ------------------------------
# (Optional in Dev, Recommended in Prod for rate-limiting & distributed caching)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_REDIS_READONLY_TOKEN=


# --- [4] Upstash QStash (Background Tasks & Scheduled Jobs) -------------------
# (Optional in Dev, Required if using QStash webhook wake/delays)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=https://qstash.upstash.io/v2/publish


# --- [5] Razorpay (Payment Processing) ----------------------------------------
# (Optional in Dev, Required for checkout & paid registrations)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# (Optional in Dev, Required for webhook verification)
RAZORPAY_WEBHOOK_SECRET_CURRENT=
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=


# --- [6] Resend (Transactional Emails) ----------------------------------------
# (Optional in Dev, Required to send confirmation & pass emails)
RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
EMAIL_FROM=TARANG 2026 <no-reply@your-verified-domain>
# Organizer inbox that receives a copy of each group-entry submission
GROUP_ENTRY_NOTIFY_EMAIL=
EMAIL_REPLY_TO=support@tarang.example.com


# --- [7] QR Code Signing (Ed25519 Cryptographic Pass Verification) -----------
# (Optional, default: k1) Signing key identifier
QR_SIGNING_KEY_ID=k1

# (Optional in Dev, Required to generate signed attendee passes)
# Generate with: node -e 'const {generateKeyPairSync}=require("crypto");const {publicKey,privateKey}=generateKeyPairSync("ed25519");console.log("PRIV:",privateKey.export({type:"pkcs8",format:"der"}).toString("base64"));console.log("PUB:",publicKey.export({type:"spki",format:"der"}).toString("base64"));'
QR_ED25519_PRIVATE_KEY_BASE64=

# (Optional in Dev, Required to verify QR passes at scanner gates)
QR_ED25519_PUBLIC_KEY_BASE64=


# --- [8] Cloudflare Turnstile (Anti-Bot Protection) ---------------------------
# (Optional in Dev, Recommended in Prod on public forms)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Enable the shared web-scanner default credential (allows volunteers to scan
# immediately with just their login on any browser/phone without hardware registration).
SCANNER_ALLOW_DEFAULT_CREDENTIAL=true


# --- [9] Google Sheets Mirror (3-Spreadsheet Audit & Backup Sync) --------------
# (Optional, default: false)
GOOGLE_SHEETS_ENABLED=false
# Option A: Google Service Account (Base64 or raw JSON)
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Dedicated Spreadsheets:
# 1. Basic Card Registrations Spreadsheet ID
# GOOGLE_SHEETS_BASIC_PASS_ID=
# 2. Delegate Card (VIP All-Access) Registrations Spreadsheet ID
# GOOGLE_SHEETS_DELEGATE_PASS_ID=
# 3. All Events Registrations Spreadsheet ID
# GOOGLE_SHEETS_EVENTS_ID=
# 4. Official Merchandise Orders Spreadsheet ID
# GOOGLE_SHEETS_MERCHANDISE_ID=
# 5. Group Entry Requests Spreadsheet ID (public /group-entry form)
# GOOGLE_SHEETS_GROUP_ENTRY_ID=
#
# Alternatively, single Master Spreadsheet with tabs ('Basic Passes', 'Delegate Passes', 'Event Registrations', 'Merchandise Orders', 'Group Entries'):
# GOOGLE_MASTER_SPREADSHEET_ID=
#
# Option B: Google Apps Script Webhook URL
# GOOGLE_SHEETS_WEBHOOK_URL=


# --- [10] Cloudflare CDN & Zone Operations ------------------------------------
# (Optional, used for cache invalidation & DNS sync scripts)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=


# --- [11] Database Logical Backups (infra/scripts/backup-db.sh) ---------------
# (Optional, required only for offsite backup automation script)
# PG_DUMP_URL=
# BACKUP_AGE_RECIPIENT=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=


# --- [12] Observability & Monitoring (Sentry / OpenTelemetry) -----------------
# (Optional)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
