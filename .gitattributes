# Normalise line endings so a Windows working copy can't ship CRLF to Linux.
#
# The VPS deploy runs infra/scripts/*.sh directly. A CRLF shebang fails with
# `bad interpreter: /usr/bin/env bash^M`, which is opaque enough to cost an
# afternoon. core.autocrlf=true happens to store LF today; this makes it a
# guarantee regardless of any contributor's local git config.

* text=auto eol=lf

# Executed on Linux — must always be LF.
*.sh              text eol=lf
Dockerfile        text eol=lf
*.conf            text eol=lf
*.service         text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf

# Binary: never touch.
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.webp            binary
*.avif            binary
*.ico             binary
*.woff            binary
*.woff2           binary
*.ttf             binary
*.otf             binary
*.pdf             binary
*.mp4             binary
*.webm            binary

# Generated — collapse diff noise in reviews.
pnpm-lock.yaml    linguist-generated=true -diff
